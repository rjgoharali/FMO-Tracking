# Copy to .env. Replace placeholders before starting. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
POSTGRES_DB=fmo_tracking
POSTGRES_USER=fmo
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://fmo:replace-with-a-long-random-database-password@localhost:5432/fmo_tracking
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7
LOG_LEVEL=info
# Phase 4 browser map key must have referrer/API restrictions.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
# Vite's same-origin development proxy; not exposed to browser JavaScript.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:4000
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
SUPABASE_URL=
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Demo seed requires explicit consent and your own passwords (minimum 12 characters).
ALLOW_DEMO_SEED=false
SEED_ADMIN_PASSWORD=
SEED_FMO_PASSWORD=
# One-time non-demo super admin bootstrap. Clear ADMIN_PASSWORD afterward.
ADMIN_EMPLOYEE_CODE=
ADMIN_NAME=
ADMIN_PASSWORD=
# Firebase client configuration (public app settings; never add service-account keys here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
